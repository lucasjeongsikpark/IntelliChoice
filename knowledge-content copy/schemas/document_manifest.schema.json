{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intellichoice.org/schemas/document_manifest.schema.json",
  "title": "IntelliChoice Knowledge Content Manifest",
  "description": "One manifest file per audience (SPEC §5.20.2). Lists every document that audience may see, with the version/effective-date metadata used for filtering (SPEC §5.20.4, §5.21.3).",
  "type": "object",
  "required": ["audience", "documents"],
  "additionalProperties": false,
  "properties": {
    "audience": {
      "type": "string",
      "enum": ["public", "parent", "student", "tutor", "branch_manager"]
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document_entry" }
    }
  },
  "$defs": {
    "document_entry": {
      "type": "object",
      "required": [
        "document_id",
        "title",
        "source_path",
        "audience",
        "access_level",
        "academic_year",
        "effective_from",
        "version",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "source_path": {
          "type": "string",
          "description": "Bucket-relative path under knowledge-content/documents/ (mirrors the S3 approved/ layout, SPEC §5.20.3)."
        },
        "audience": {
          "type": "string",
          "enum": ["public", "parent", "student", "tutor", "branch_manager"]
        },
        "access_level": { "type": "string", "minLength": 1 },
        "branch_external_id": { "type": ["string", "null"] },
        "academic_year": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
        "effective_from": { "type": "string", "format": "date" },
        "effective_to": { "type": ["string", "null"], "format": "date" },
        "version": { "type": "integer", "minimum": 1 },
        "status": { "type": "string", "enum": ["draft", "approved"] },
        "supersedes_document_id": { "type": ["string", "null"] }
      }
    }
  }
}
