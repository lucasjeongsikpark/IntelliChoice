{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intellichoice.org/schemas/metadata.schema.json",
  "title": "IntelliChoice RAG Chunk Metadata",
  "description": "The metadata fields attached to every chunk during ingestion (SPEC §5.21.2), independent of the chunk_text/embedding/search_vector values themselves. Used to validate what the ingestion pipeline extracts before it is persisted to rag_chunks.",
  "type": "object",
  "required": [
    "document_id",
    "document_title",
    "audience",
    "access_level",
    "academic_year",
    "effective_from",
    "status",
    "source_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "document_id": { "type": "string", "minLength": 1 },
    "parent_chunk_id": { "type": ["string", "null"] },
    "document_title": { "type": "string", "minLength": 1 },
    "page_number": { "type": ["integer", "null"], "minimum": 1 },
    "section_title": { "type": ["string", "null"] },
    "branch_external_id": { "type": ["string", "null"] },
    "audience": {
      "type": "string",
      "enum": ["public", "parent", "student", "tutor", "branch_manager"]
    },
    "access_level": { "type": "string", "minLength": 1 },
    "academic_year": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$" },
    "effective_from": { "type": "string", "format": "date" },
    "effective_to": { "type": ["string", "null"], "format": "date" },
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
