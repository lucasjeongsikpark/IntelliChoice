CHAT_MYSQL_URL=mysql+aiomysql://intellichoice:intellichoice@localhost:3306

# Offline question-authoring pipeline (`make question-gen-authored`, D-188). Its own env
# prefix and its own defaults, deliberately not shared with the apps (see
# `packages/curriculum/.../settings.py`). Absent from this file until 2026-08-05, which is
# why the first real authoring run needed two questions answered before it could start.
#
# The default provider is `mock`, so a run against real Bedrock has to say so. The four
# model ids below are the decided roster (D-273, measured 2026-08-11) and are the same
# values `settings.py` now defaults to, so copying this file verbatim configures a run
# that preflight will start. Note they are cross-region inference profile ids (`us.`),
# which is what this account can actually invoke (D-084); the flagship models are gated
# behind a "contact AWS Sales" wall and `anthropic.claude-sonnet-5` reports AVAILABLE and
# denies the call. Availability is a dated measurement - re-measure before a paid run
# rather than trusting 2026-08-11. All four LLM slots are set because the authored solvers
# deliberately reuse the shape pipeline's two task slots to resolve to different models.
#
# `CURRICULUM_BEDROCK_RUN_BUDGET_CENTS` is a real spend ceiling for one batch run, checked
# before each call against the run's cumulative cost - keep it near what the run should
# cost, not at the 1000 default.
CURRICULUM_BEDROCK_PROVIDER=mock
CURRICULUM_BEDROCK_AWS_REGION=us-east-1
# Generator - the role where capability matters most, so it takes the mid-tier model.
# Shares weights with REVIEW (Solver B) below: the invocable set is two models, so one
# of the three roles must share, and preflight forbids Solver A == Solver B (D-273).
CURRICULUM_BEDROCK_AUTHORED_GENERATION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
CURRICULUM_BEDROCK_JUDGE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# D-230: GENERATION and REVIEW must name **different** models. They are not only the two
# review slots - `ai_pipeline` deliberately reuses them as Solver A and Solver B rather than
# adding a third setting, so setting them to one id makes the panel one opinion counted
# twice. `pipeline_cli --preflight` refuses a paid run when they match, which means the
# previous version of this file - all four slots on one id - documented a pipeline that
# could not start. Found by D-229 when the audit's own preflight refused for the same reason.
CURRICULUM_BEDROCK_GENERATION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
CURRICULUM_BEDROCK_REVIEW_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
CURRICULUM_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
CURRICULUM_BEDROCK_RUN_BUDGET_CENTS=100

# Organization local-time convention (D-130) - decides which week attendance is read for.
# Unprefixed on purpose: the two apps disagreeing about what week it is would be a defect.
# THE VALUES BELOW ARE A PROVISIONAL DEFAULT, not a confirmed fact. `America/Chicago` is
# inferred from a hard-coded `-6` in icrest's report queries; the org has not confirmed it.
# Both apps log this at WARNING every startup until ORG_TIME_CONFIRMED=true.
#
# After the org manager confirms, set these three and redeploy - no code change:
#   ORG_TIMEZONE          any IANA zone name
#   ORG_TIME_CONVENTION   local_dst_aware          real local time, DST included (correct)
#                         legacy_fixed_utc_minus_6 mimic icrest's reports exactly
#   ORG_TIME_CONFIRMED    true, once it is actually confirmed - silences the warning
ORG_TIMEZONE=America/Chicago
ORG_TIME_CONVENTION=local_dst_aware
ORG_TIME_CONFIRMED=false

# --- Observability (SPEC §5.32) ------------------------------------------------------
#
# Absent from this file until 2026-08-14, which meant the only way to discover that any of
# it was configurable was to read `packages/observability`. Local dev needs none of it:
# tracing goes to Jaeger via the collector `make dev-observability` starts, and LangSmith
# stays off because `LANGSMITH_API_KEY` is unset.
#
# OTEL_ENABLED            false locally unless you ran `make dev-observability`
# OTEL_SERVICE_NAME       one per app; what the trace and metric attribution is keyed on
# OTEL_EXPORTER_OTLP_ENDPOINT
#                         the collector, not the backend - staging runs it as a sidecar and
#                         forwards to X-Ray (see docs/ARCHITECTURE.md's egress section)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=learning-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
#
# LangSmith (D-242: the account is real and staging traces to it; local stays off).
# **Leave LANGSMITH_API_KEY unset here and everywhere else in the repo** - it belongs in
# Secrets Manager, and `configure_langsmith()` is a deliberate no-op without it.
# Both HIDE_ flags are forced on for the Cloud option by SPEC §5.32.1's "complete PII
# masking"; they are listed so nobody discovers them by turning tracing on and reading a
# student's prompt in a dashboard.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=intellichoice-staging
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
